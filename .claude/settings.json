{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-locale-parity.mjs --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes aislop@0.16.1 hook claude",
            "__aislop": {
              "v": 1,
              "managed": true,
              "hash": "sha256:76c5d8b7bfc1fd04c7b17dd5bf5c1d51"
            },
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "graphify update .",
            "timeout": 120
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".aislop/config.yml|.aislop/rules.yml|package.json",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes aislop@0.16.1 hook claude --on-file-changed",
            "__aislop": {
              "v": 1,
              "managed": true,
              "hash": "sha256:a7a5e96a04eac99b2d7f53066df9dc2e"
            },
            "timeout": 90
          }
        ]
      }
    ]
  }
}
