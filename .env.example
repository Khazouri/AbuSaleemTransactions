APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Origin of the Vue SPA. config/cors.php uses this as the ONE allowed origin,
# so it must match the browser's Origin header exactly — scheme + host, no
# trailing slash and no path. Unset in production means the default
# http://localhost:5173 is allowed instead, and every real request fails
# preflight.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stage 26 — backups. mysqldump must be reachable from wherever PHP runs; on a
# Windows host that is usually an absolute path, inside Homestead just the name.
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_RETENTION_DAYS=30
BACKUP_INCLUDE_FILES=true

# Maintenance console (the `maintenance` screen) — deployment commands for a
# host with no SSH. Leave the console on until a deployment has settled; it is
# the only way to run migrations on cPanel shared hosting. Turning it off makes
# every one of its endpoints refuse.
MAINTENANCE_CONSOLE_ENABLED=true
# ONE-TIME bootstrap token. Unlocks the unauthenticated page that creates the
# console's own table and screen row -- the step that cannot be done from
# inside the console, because the console does not exist yet. Empty means the
# page does not answer at all. Minimum 24 characters; shorter values are
# refused, because this is the one public endpoint that can migrate the
# database. It closes itself once the console becomes reachable, but clear the
# value anyway once the deployment has settled.
#   Visit: https://<your-api-domain>/api/maintenance/bootstrap?token=<value>
MAINTENANCE_BOOTSTRAP_TOKEN=
# Shell commands (composer/npm) need proc_open, which shared hosting often
# forbids. Setting this false hides them rather than offering buttons that
# cannot work; artisan commands are unaffected — they run in-process.
MAINTENANCE_SHELL_ENABLED=true
# Binary paths. On cPanel none of these are on the web user's PATH under their
# plain names — the screen probes each one and reports which actually answer.
# Typical cPanel values:
#   MAINTENANCE_PHP_PATH=/opt/cpanel/ea-php82/root/usr/bin/php
#   MAINTENANCE_COMPOSER_PATH=/opt/cpanel/composer/bin/composer
#   MAINTENANCE_NPM_PATH=/home/<account>/nodevenv/<app>/20/bin/npm
MAINTENANCE_COMPOSER_PATH=composer
MAINTENANCE_NPM_PATH=npm
# Seconds a subprocess may run. PHP's own max_execution_time usually binds
# first on shared hosting; the screen reports it for that reason.
MAINTENANCE_TIMEOUT=300
